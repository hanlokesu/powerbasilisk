#!/bin/sh
# Pre-commit gate.
#
#   git commit                -> formatting check only (about a second)
#   PBHOOK_FULL=1 git commit  -> the whole local CI mirror (slow)
#
# The full mirror runs on push anyway, so keeping the commit gate fast is safe.
# The previous revision of this hook ran clippy, a release build and 28 test
# runs on every commit, and it never executed at all because core.hooksPath was
# unset - which is how a formatting failure reached GitHub as commit 2fd3b0d.
set -e

. "$(dirname "$0")/ci-mirror.sh"

pb_fmt_gate

if [ "$PBHOOK_FULL" = "1" ]; then
  echo "pre-commit: PBHOOK_FULL=1 - running the full local CI mirror"
  pb_full_mirror
fi
